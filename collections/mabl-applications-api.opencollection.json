{
  "opencollection": "1.0.0",
  "info": {
    "name": "mabl Applications API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Applications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get applications by workspace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mabl.com/applications",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get applications by workspace"
        },
        {
          "info": {
            "name": "Create application",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mabl.com/applications",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create application"
        },
        {
          "info": {
            "name": "Get application by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mabl.com/applications/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get application by ID"
        },
        {
          "info": {
            "name": "Update an existing application",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mabl.com/applications/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing application"
        },
        {
          "info": {
            "name": "Remove application",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.mabl.com/applications/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove application"
        }
      ]
    }
  ],
  "bundled": true
}