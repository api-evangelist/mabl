            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get flow metadata"
        },
        {
          "info": {
            "name": "Update flow metadata",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.mabl.com/flows/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update flow metadata"
        }
      ]
    }
  ],
  "bundled": true
}