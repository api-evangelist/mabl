{
  "opencollection": "1.0.0",
  "info": {
    "name": "mabl Applications Flows API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Flows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get flow metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
